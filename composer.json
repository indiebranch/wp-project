{
  "name": "indiebranch/wp-project",
  "type": "project",
  "license": "MIT",
  "description": "A reusable WordPress project starter based on Roots Bedrock, with Composer and a public document root",
  "homepage": "https://github.com/indiebranch/wp-project",
  "authors": [
    {
      "name": "Nomad Labs Ltd trading as IndieBranch",
      "homepage": "https://github.com/indiebranch"
    }
  ],
  "keywords": [
    "bedrock", "composer", "roots", "wordpress-composer", "wordpress", "wp-composer", "wp-config", "wp"
  ],
  "support": {
    "issues": "https://github.com/indiebranch/wp-project/issues",
    "source": "https://github.com/indiebranch/wp-project"
  },
  "repositories": [
    {
      "name": "wp-packages",
      "type": "composer",
      "url": "https://repo.wp-packages.org"
    }
  ],
  "require": {
    "php": ">=8.3",
    "composer/installers": "^2.0",
    "oscarotero/env": "^2.0",
    "roots/bedrock-autoloader": "^1.0",
    "roots/bedrock-disallow-indexing": "^2.0",
    "roots/wordpress": "7.1.3",
    "roots/wp-config": "^1.0",
    "vlucas/phpdotenv": "^5.0",
    "wp-plugin/fluent-smtp": "^2.4",
    "wp-plugin/redirection": "^5.10",
    "wp-plugin/safe-svg": "^2.5",
    "wp-plugin/stream": "^4.4",
    "wp-plugin/two-factor": "^0.17.0",
    "wp-plugin/wp-robots-txt": "^1.3",
    "wp-theme/twentytwentyfive": "^1.0"
  },
  "require-dev": {
    "laravel/pint": "^1.0",
    "pestphp/pest": "^4.0",
    "php-parallel-lint/php-parallel-lint": "^1.4",
    "php-stubs/wordpress-stubs": "^7.1",
    "phpstan/phpstan": "^2.3",
    "wp-plugin/query-monitor": "^4.0",
    "wp-plugin/rewrite-rules-inspector": "^1.6",
    "wp-plugin/transients-manager": "^2.0",
    "wp-plugin/user-switching": "^1.12",
    "wp-plugin/wp-crontrol": "^2.0"
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "allow-plugins": {
      "composer/installers": true,
      "roots/wordpress-core-installer": true,
      "pestphp/pest-plugin": true
    },
    "sort-packages": true
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "extra": {
    "installer-paths": {
      "public/app/mu-plugins/{$name}/": [
        "type:wordpress-muplugin"
      ],
      "public/app/plugins/{$name}/": [
        "type:wordpress-plugin"
      ],
      "public/app/themes/{$name}/": [
        "type:wordpress-theme"
      ]
    },
    "wordpress-install-dir": "public/wp"
  },
  "scripts": {
    "analyse": "phpstan analyse --configuration=phpstan.neon.dist --no-progress",
    "ci": [
      "@composer validate --no-check-publish",
      "@composer audit --locked",
      "@lint:syntax",
      "@lint",
      "@analyse",
      "@test"
    ],
    "lint": "pint --test",
    "lint:fix": "pint",
    "lint:syntax": "parallel-lint --exclude vendor --exclude node_modules config tests public/index.php public/wp-config.php public/app/mu-plugins public/app/themes",
    "test": "pest"
  }
}
