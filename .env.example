# DATABASE
# --------
DB_NAME='database_name'
DB_USER='database_user'
DB_PASSWORD='database_password'

# Optionally, you can use a data source name (DSN)
# When using a DSN, you can remove the DB_NAME, DB_USER, DB_PASSWORD, and DB_HOST variables
# DATABASE_URL='mysql://database_user:database_password@database_host:database_port/database_name'

# Optional database variables
# DB_HOST='localhost'
# DB_HOST='127.0.0.1' # Use if you encounter mysqli 2002 / socket connection issues
# DB_PREFIX='wp_'

# ENVIRONMENT
# -----------
# Selects the config file at config/environments/{WP_ENV}.php.
# Valid values: development | staging | production
WP_ENV='development'

# Tells WordPress and plugins what kind of environment this is.
# Use local for local development; otherwise match WP_ENV.
# Valid values: local | development | staging | production
WP_ENVIRONMENT_TYPE='local'

# APPLICATION URLS
# ----------------
WP_HOME='http://example.com'
WP_SITEURL="${WP_HOME}/wp"

# DEBUGGING
# ---------
# When WP_ENV='development', config/environments/development.php enables
# WP_DEBUG and defaults WP_DEBUG_LOG to true.
# Set WP_DEBUG_LOG below to false to disable logging, or to an absolute log path.
# WP_DEBUG_LOG=true

# CRON
# ----
# Disable request-triggered cron only when using an external scheduler.
DISABLE_WP_CRON=false

# TWO-FACTOR POLICY
# -----------------
# Require administrators to use two-factor authentication.
# Set to false during initial enrollment; existing users' 2FA stays enabled.
ENFORCE_TWO_FACTOR_POLICY=true

# MAIL
# ----
# Postmark Server API Token for FluentSMTP's configuration-file credential storage.
# FLUENTMAIL_POSTMARK_API_KEY=''

# AUTHENTICATION KEYS AND SALTS
# -----------------------------
# Generate unique values for each installation: https://roots.io/salts.html
# Replace all eight placeholders before use.
AUTH_KEY='replace-with-a-unique-auth-key'
SECURE_AUTH_KEY='replace-with-a-unique-secure-auth-key'
LOGGED_IN_KEY='replace-with-a-unique-logged-in-key'
NONCE_KEY='replace-with-a-unique-nonce-key'
AUTH_SALT='replace-with-a-unique-auth-salt'
SECURE_AUTH_SALT='replace-with-a-unique-secure-auth-salt'
LOGGED_IN_SALT='replace-with-a-unique-logged-in-salt'
NONCE_SALT='replace-with-a-unique-nonce-salt'
